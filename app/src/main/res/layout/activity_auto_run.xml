<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Run settings. Same shell as activity_about.xml (72dp white top bar with
     a top-right close button, 1dp divider, scrollable white body) so the screen
     matches the camera/About screens. Body holds two independently-toggled rules:
     auto-save-QR (keyword match) and auto-open-link (domain whitelist), each a
     SwitchCompat plus a multi-line EditText (one entry per line). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/auto_run_top_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/auto_run_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_run_title"
            android:textColor="#000000"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/container_auto_run_back"
            android:layout_width="72dp"
            android:layout_height="0dp"
            android:foreground="@drawable/btn_toolbar_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/btn_auto_run_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/auto_run_back_desc"
                app:tint="@color/btn_toolbar_tint" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/auto_run_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/auto_run_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/auto_run_divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Rule 1: auto-save matching content as a QR image -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_run_save_qr_heading"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_auto_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/GreySwitchOverlay"
                    app:thumbTint="@color/switch_thumb_tint"
                    app:trackTint="@color/switch_track_tint" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/auto_run_save_qr_desc"
                android:textColor="#444444"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Keyword input list. Hidden while the rule is off; when on, holds one
                 or more single-line underlined rows added under rows_keywords, plus
                 the "+" button. Rows are managed in AutoRunActivity. -->
            <LinearLayout
                android:id="@+id/section_keywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rows_keywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- Square sized to the input-row height at runtime (see addRow),
                     so the "+" sits centred in an imaginary square matching a row. -->
                <ImageView
                    android:id="@+id/btn_add_keyword"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="3dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auto_run_add_row" />
            </LinearLayout>

            <!-- Rule 2: auto-open whitelisted links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_run_open_link_heading"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_auto_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/GreySwitchOverlay"
                    app:thumbTint="@color/switch_thumb_tint"
                    app:trackTint="@color/switch_track_tint" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/auto_run_open_link_desc"
                android:textColor="#444444"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Domain whitelist input list. Same structure as the keyword list. -->
            <LinearLayout
                android:id="@+id/section_whitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rows_whitelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- Square sized to the input-row height at runtime (see addRow),
                     so the "+" sits centred in an imaginary square matching a row. -->
                <ImageView
                    android:id="@+id/btn_add_whitelist"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auto_run_add_row" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
